// Inventory & Profit Tracking — data model
//
// Design rules baked in here:
//  * Profit / revenue are NEVER stored. They are derived from
//    (sale.sale_price - batch.unit_cost) * sale.quantity at query time.
//  * Nothing is hard-deleted: batches, sales, areas and shops carry is_deleted.
//  * Batch.remaining_qty is the single source of truth for stock on hand and is
//    guarded by a CHECK constraint (see the init migration) plus a transactional
//    conditional update in the sale server action.
//  * Every batch and sale carries created_by / created_at, and writes are mirrored
//    into audit_logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used only by the Prisma CLI (migrate / studio). Pooled connections cannot
  // run DDL reliably, so migrations go over the direct endpoint.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Area {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  shops     Shop[]
  sales     Sale[]
  bookings  Booking[]

  @@index([isDeleted])
  @@map("areas")
}

model Shop {
  id        Int       @id @default(autoincrement())
  areaId    Int       @map("area_id")
  name      String
  /// Optional delivery address. Entered once per shop and printed on every
  /// invoice for that shop, so a booker never retypes it.
  address   String?
  /// Optional WhatsApp / contact number for the shopkeeper. Used to pre-fill the
  /// "send this invoice on WhatsApp" dialog.
  phone     String?
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  area      Area      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  sales     Sale[]
  bookings  Booking[]

  // One shop name per area. Also gives "add on the fly" a natural upsert target.
  @@unique([areaId, name])
  @@index([areaId, isDeleted])
  @@map("shops")
}

model Product {
  id               Int      @id @default(autoincrement())
  categoryId       Int      @map("category_id")
  name             String
  packagingType    String   @map("packaging_type")
  variantValue     String   @map("variant_value")
  sku              String   @unique
  unit             String
  defaultSalePrice Decimal  @default(0) @map("default_sale_price") @db.Decimal(12, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  batches          Batch[]
  sales            Sale[]

  // A product is the unique combination of category + name + packaging + variant.
  // name: sets the Prisma client key; map: sets the actual Postgres index name.
  @@unique([categoryId, name, packagingType, variantValue], name: "product_identity", map: "product_identity")
  @@index([categoryId])
  @@index([packagingType])
  @@index([variantValue])
  @@map("products")
}

model Batch {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  quantity       Int
  remainingQty   Int      @map("remaining_qty")
  unitCost       Decimal  @map("unit_cost") @db.Decimal(12, 2)
  receivedDate   DateTime @map("received_date") @db.Date
  notes          String?
  isDeleted      Boolean  @default(false) @map("is_deleted")
  idempotencyKey String?  @unique @map("idempotency_key")
  createdBy      String   @default("system") @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sales          Sale[]

  // Drives the "batches with stock left for this product" dropdown query.
  @@index([productId, isDeleted, remainingQty])
  @@index([receivedDate])
  @@map("batches")
}

model Sale {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  batchId        Int      @map("batch_id")
  areaId         Int      @map("area_id")
  shopId         Int?     @map("shop_id")
  // Set when the sale came from a booking. One booking line can span several
  // batches, so a booking has many sales.
  bookingId      Int?     @map("booking_id")
  quantity       Int
  salePrice      Decimal  @map("sale_price") @db.Decimal(12, 2)
  saleDate       DateTime @map("sale_date") @db.Date
  notes          String?
  isDeleted      Boolean  @default(false) @map("is_deleted")
  idempotencyKey String?  @unique @map("idempotency_key")
  createdBy      String   @default("system") @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  area           Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  shop           Shop?    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  // Dashboard aggregates all scan by (is_deleted, sale_date) then join batches.
  @@index([isDeleted, saleDate])
  @@index([saleDate])
  @@index([areaId, saleDate])
  @@index([shopId, saleDate])
  @@index([productId, saleDate])
  @@index([batchId])
  @@index([bookingId])
  @@map("sales")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  action     String
  actor      String
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// An order taken by a booker. Creating one immediately records the underlying
/// sales (drawing stock down oldest-batch-first), so the booker never has to
/// think about batches.
///
/// Deliberately has no line table: each booking line IS one or more Sale rows.
/// That means the invoice is rendered from exactly the rows the dashboard
/// aggregates, so an invoice total can never drift from recorded revenue.
model Booking {
  id             Int      @id @default(autoincrement())
  invoiceNo      String   @unique @map("invoice_no")
  /// Random, unguessable id for the shareable invoice link. The in-app PDF
  /// button uses the numeric id, but anything sent to a customer uses this, so
  /// a recipient cannot walk the sequence and read other people's invoices.
  shareToken     String?  @unique @map("share_token")
  customerName   String?  @map("customer_name")
  customerPhone  String?  @map("customer_phone")
  areaId         Int      @map("area_id")
  shopId         Int?     @map("shop_id")
  bookingDate    DateTime @map("booking_date") @db.Date
  notes          String?
  isDeleted      Boolean  @default(false) @map("is_deleted")
  idempotencyKey String?  @unique @map("idempotency_key")
  createdBy      String   @default("system") @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  area           Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  shop           Shop?    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sales          Sale[]

  @@index([isDeleted, bookingDate])
  @@index([bookingDate])
  @@index([areaId, bookingDate])
  @@map("bookings")
}

/// Per-year invoice numbering. A single atomic upsert hands out the next number,
/// so two bookers submitting at the same moment cannot get the same invoice no.
model InvoiceCounter {
  year   Int @id
  lastNo Int @map("last_no")

  @@map("invoice_counters")
}
