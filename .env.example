# ---------------------------------------------------------------------------
# DATABASE_URL - used by the app at runtime.
#
# Local PostgreSQL, or any non-pooled connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
#
# Hosted provider, LOCAL DEV: use the DIRECT endpoint with a normal pool.
# One Node process serves every request and the dashboard fires ~8 aggregate
# queries at once, so connection_limit=1 makes them queue and time out.
#   DATABASE_URL="postgresql://USER:PW@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require&connect_timeout=20&pool_timeout=30"
#
# Hosted provider, SERVERLESS (Vercel): use the POOLED endpoint plus
# pgbouncer=true, and keep the per-instance pool small because there are many
# instances. pool_timeout above the default 10s absorbs a cold start.
#   DATABASE_URL="postgresql://USER:PW@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE_URL_UNPOOLED - used ONLY by the Prisma CLI (migrate, studio).
#
# A transaction pooler cannot run DDL reliably, so migrations go over the
# direct endpoint. Running locally against one plain PostgreSQL server? Set it
# to exactly the same value as DATABASE_URL.
#
# Required: the Prisma CLI errors out if this is referenced but unset. The app
# itself does NOT need it at runtime.
#
# Neon's direct endpoint is the pooled host without "-pooler":
#   DATABASE_URL_UNPOOLED="postgresql://USER:PW@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
# ---------------------------------------------------------------------------

# Label written into created_by and the audit trail. Replace with real auth later.
DEFAULT_ACTOR="owner"

# ---------------------------------------------------------------------------
# Your business details, printed at the top of every invoice PDF.
# ---------------------------------------------------------------------------
BUSINESS_NAME="Your Business Name"
BUSINESS_ADDRESS=""
BUSINESS_PHONE=""
BUSINESS_EMAIL=""
BUSINESS_TAX_ID=""

# Groq (Whisper) speech-to-text. Optional - the browser engine works without it.
# Server-side only: never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=""
GROQ_STT_MODEL="whisper-large-v3"

# Transcription endpoint. Defaults to Groq; point it at a local server to try
# a Hugging Face model - see scripts/stt-server.py.
#   STT_BASE_URL="http://127.0.0.1:8123/v1"
#   STT_MODEL="kingabzpro/whisper-large-v3-turbo-urdu"
#   STT_API_KEY=""
STT_BASE_URL=""
STT_MODEL=""
STT_API_KEY=""

# ---------------------------------------------------------------------------
# Understanding a spoken command
#
# A language model reads the sentence and returns ids from your own catalog.
# Optional: with no key at all, the rule-based parser is used instead, which
# handles the phrasings it was written for and not much else.
#
# Nothing the model says is trusted. Every id it returns is checked against the
# catalog, and every write is still a proposal you confirm on screen.

# Which engine. "auto" (the default) uses Anthropic when its key is set and the
# free endpoint otherwise. Pin it to "groq" to stay on the free tier even if an
# Anthropic key is present for something else. Set it to "off" to go back to the
# rule parser - worth knowing about, because the free path needs no key of its
# own and switches itself on wherever a Groq key is already set for Whisper.
LLM_PROVIDER="auto"

# The free path, and the default. Needs no new account: the Groq key below is
# the same one Whisper already uses. Measured against this catalog, gpt-oss-120b
# resolved shop and product names spoken in Urdu script onto the right ids and
# abstained on ambiguous sentences instead of guessing.
#
# Free-tier limit is 8000 tokens a minute and one command costs about 2300, so
# roughly three commands a minute. A rate limit is retried once, then falls back
# to the rule parser.
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
# Falls back to GROQ_API_KEY, then STT_API_KEY, if left empty.
LLM_API_KEY=""

# The paid path. Stronger, and used automatically when this is set.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# low | medium | high. Low keeps it quick; this is a short extraction task.
ANTHROPIC_EFFORT="low"
