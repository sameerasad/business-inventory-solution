# ---------------------------------------------------------------------------
# DATABASE_URL - used by the app at runtime.
#
# Local PostgreSQL, or any non-pooled connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
#
# On a serverless host (Vercel), use the provider's POOLED endpoint and add
# pgbouncer=true so Prisma stops using prepared statements, e.g. Neon:
#   DATABASE_URL="postgresql://USER:PW@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE_URL_UNPOOLED - used ONLY by the Prisma CLI (migrate, studio).
#
# A transaction pooler cannot run DDL reliably, so migrations go over the
# direct endpoint. Running locally against one plain PostgreSQL server? Set it
# to exactly the same value as DATABASE_URL.
#
# Required: the Prisma CLI errors out if this is referenced but unset. The app
# itself does NOT need it at runtime.
#
# Neon's direct endpoint is the pooled host without "-pooler":
#   DATABASE_URL_UNPOOLED="postgresql://USER:PW@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
# ---------------------------------------------------------------------------

# Label written into created_by and the audit trail. Replace with real auth later.
DEFAULT_ACTOR="owner"
