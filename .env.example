# ---------------------------------------------------------------------------
# DATABASE_URL - used by the app at runtime.
#
# Local PostgreSQL, or any non-pooled connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
#
# Hosted provider, LOCAL DEV: use the DIRECT endpoint with a normal pool.
# One Node process serves every request and the dashboard fires ~8 aggregate
# queries at once, so connection_limit=1 makes them queue and time out.
#   DATABASE_URL="postgresql://USER:PW@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require&connect_timeout=20&pool_timeout=30"
#
# Hosted provider, SERVERLESS (Vercel): use the POOLED endpoint plus
# pgbouncer=true, and keep the per-instance pool small because there are many
# instances. pool_timeout above the default 10s absorbs a cold start.
#   DATABASE_URL="postgresql://USER:PW@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE_URL_UNPOOLED - used ONLY by the Prisma CLI (migrate, studio).
#
# A transaction pooler cannot run DDL reliably, so migrations go over the
# direct endpoint. Running locally against one plain PostgreSQL server? Set it
# to exactly the same value as DATABASE_URL.
#
# Required: the Prisma CLI errors out if this is referenced but unset. The app
# itself does NOT need it at runtime.
#
# Neon's direct endpoint is the pooled host without "-pooler":
#   DATABASE_URL_UNPOOLED="postgresql://USER:PW@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
# ---------------------------------------------------------------------------

# Label written into created_by and the audit trail. Replace with real auth later.
DEFAULT_ACTOR="owner"

# ---------------------------------------------------------------------------
# Your business details, printed at the top of every invoice PDF.
# ---------------------------------------------------------------------------
BUSINESS_NAME="Your Business Name"
BUSINESS_ADDRESS=""
BUSINESS_PHONE=""
BUSINESS_EMAIL=""
BUSINESS_TAX_ID=""

# Groq (Whisper) speech-to-text. Optional - the browser engine works without it.
# Server-side only: never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=""
GROQ_STT_MODEL="whisper-large-v3"
